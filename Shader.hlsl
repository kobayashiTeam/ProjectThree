// =========================================================
// 1. 構造体の定義 (C++の構造体と合わせる)
// =========================================================

// 頂点シェーダーに入ってくるデータ (C++から送られてくる)
struct VS_INPUT
{
    float4 Pos : POSITION; // : POSITION は「セマンティクス」
};

// 頂点シェーダーから出て、ピクセルシェーダーに入っていくデータ
struct PS_INPUT
{
    float4 Pos : SV_POSITION; // SV_ は System Value (システム予約) の意味
};

// =========================================================
// 2. 頂点シェーダー (Vertex Shader)
// =========================================================
PS_INPUT VS(VS_INPUT input)
{
    PS_INPUT output = (PS_INPUT) 0;
    
    // 今回は座標変換（行列計算）をせず、そのまま右から左へ受け流す
    output.Pos = input.Pos;
    
    return output;
}

// =========================================================
// 3. ピクセルシェーダー (Pixel Shader / OpenGLのFragment Shader)
// =========================================================
float4 PS(PS_INPUT input) : SV_TARGET
{
    // 戻り値はRGBAの色。今回は白色 (1.0, 1.0, 1.0, 1.0) を返す
    return float4(1.0f, 1.0f, 1.0f, 1.0f);
}